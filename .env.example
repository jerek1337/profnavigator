# Скопируйте в .env и заполните. Пустые значения — функция отключена.

# --- MAX (основная платформа) ---
MAX_TOKEN=
MAX_API_URL=https://platform-api.max.ru
# Только header: с 2025 года MAX не принимает токен в query-параметрах (dev.max.ru).
# Значение query оставлено для совместимости и приведёт к 401.
MAX_AUTH_MODE=header
# Ссылка на бота, например https://max.ru/имя_бота — для QR-кода и плаката
BOT_LINK=

# --- Telegram (необязательно) ---
TELEGRAM_TOKEN=

# --- ИИ: порядок провайдеров, используются те, у кого заданы ключи ---
AI_PROVIDERS=yandexgpt,gigachat,openai
AI_TIMEOUT=20
AI_TOTAL_TIMEOUT=30
AI_RETRIES=1

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# Ключ авторизации (Base64) из личного кабинета GigaChat API
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Путь к сертификату НУЦ Минцифры, если система его не знает
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Веб-интерфейс, виджет, дашборд ---
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Публичный https-адрес сервера: нужен для кнопок «Веб-версия» и учёта переходов на fin-olimp.ru
PUBLIC_URL=
# Пароль дашборда: /dashboard?token=...
ADMIN_TOKEN=
# Секрет подписи ссылок; если пусто — создаётся и хранится в базе
SECRET_KEY=
# true, если сервер стоит за nginx/прокси
TRUST_PROXY=false

# --- Прочее ---
DB_PATH=data/profnavigator.db
REMINDER_DELAY_HOURS=168
REMINDER_MAX=4
REMINDER_CHECK_SECONDS=300
QA_DAILY_LIMIT=20
LOG_LEVEL=INFO
